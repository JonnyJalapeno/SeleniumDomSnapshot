<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SeleniumDomSnapshot</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>SeleniumDomSnapshot</PackageId>
    <Version>1.0.0</Version>
    <Authors>Piotr Burzała</Authors>
	<PackageProjectUrl>https://github.com/JonnyJalapeno/SeleniumDomSnapshot</PackageProjectUrl>
	<RepositoryUrl>https://github.com/JonnyJalapeno/SeleniumDomSnapshot</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
    <Description>Captures and diffs DOM snapshots during Selenium test runs. Helps diagnose why tests broke by showing exactly what changed in the page structure.</Description>
    <PackageTags>selenium webdriver testing dom diff snapshot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Bundle README into the package so NuGet.org displays it -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.18.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.60" />
  </ItemGroup>

</Project>
