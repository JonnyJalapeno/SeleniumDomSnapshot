<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SeleniumDomSnapshot.NUnit</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>SeleniumDomSnapshot.NUnit</PackageId>
    <Version>1.0.0</Version>
    <Authors>Piotr Burzała</Authors>
	<PackageProjectUrl>https://github.com/JonnyJalapeno/SeleniumDomSnapshot</PackageProjectUrl>
	<RepositoryUrl>https://github.com/JonnyJalapeno/SeleniumDomSnapshot</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
    <Description>NUnit integration for SeleniumDomSnapshot. Provides the [DomSnapshot] attribute for automatic DOM capture on test pass/fail.</Description>
    <PackageTags>selenium nunit testing dom diff snapshot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Bundle README into the package so NuGet.org displays it -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeleniumDomSnapshot\SeleniumDomSnapshot.csproj" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.18.1" />
  </ItemGroup>

</Project>
